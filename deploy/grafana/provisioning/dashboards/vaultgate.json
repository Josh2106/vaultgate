{
  "title": "vaultgate API",
  "uid": "vaultgate-api",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests / s by status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(vaultgate_http_requests_total[5m]))" }]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by route",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(vaultgate_http_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "type": "timeseries",
      "title": "Logins by outcome",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (outcome) (rate(vaultgate_auth_logins_total[5m]))" }]
    },
    {
      "type": "stat",
      "title": "Refresh-token reuse, 24h (token theft signal)",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "targets": [{ "expr": "sum(increase(vaultgate_auth_refresh_reuse_total[24h]))" }]
    },
    {
      "type": "stat",
      "title": "Rate-limited requests, 1h",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "targets": [{ "expr": "sum(increase(vaultgate_rate_limited_total[1h]))" }]
    }
  ]
}
