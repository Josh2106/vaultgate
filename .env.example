# Copy to .env for local development. Every setting is VG_-prefixed; see app/core/config.py.
# Defaults are development-safe; production refuses to start with insecure values.

VG_ENVIRONMENT=development          # development | test | staging | production
VG_LOG_LEVEL=INFO
VG_LOG_JSON=false                   # human-readable logs locally
VG_PUBLIC_BASE_URL=http://localhost:8000

# --- storage ---------------------------------------------------------------
VG_DATABASE_URL=sqlite+aiosqlite:///./vaultgate.db
# VG_DATABASE_URL=postgresql+asyncpg://vaultgate:change-me@localhost:5432/vaultgate
# VG_REDIS_URL=redis://localhost:6379/0     # unset = in-memory rate limiter / idempotency

# --- keys (auto-generated in dev; must be provisioned in production) -------
VG_JWT_KEYS_DIR=./.keys/jwt
VG_JWT_AUTO_GENERATE=true
# VG_JWT_ACTIVE_KID=20260101-abcd1234
VG_MASTER_KEY_FILE=./.keys/master-keys.json
VG_MASTER_KEY_AUTO_GENERATE=true

# --- auth ------------------------------------------------------------------
VG_ACCESS_TOKEN_TTL_SECONDS=900
VG_REFRESH_TOKEN_TTL_SECONDS=1209600
VG_LOCKOUT_THRESHOLD=5
VG_LOCKOUT_SECONDS=900
VG_REQUIRE_VERIFIED_EMAIL=true
VG_EMAIL_BACKEND=console            # verification emails are printed to the log

# --- HTTP hardening --------------------------------------------------------
VG_CORS_ORIGINS=http://localhost:5173
VG_MAX_BODY_BYTES=262144
VG_TRUSTED_PROXY_HOPS=0
VG_HSTS_ENABLED=false
VG_RATE_LIMIT_ENABLED=true

# --- observability ---------------------------------------------------------
VG_METRICS_ENABLED=true
# VG_METRICS_TOKEN=generate-a-long-random-value
VG_OTEL_ENABLED=false
# VG_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
